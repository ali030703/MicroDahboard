# Purpose: Ignores generated build output, local secrets, logs, caches, and database artifacts.
# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/frontend/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
/frontend/node_modules
npm-debug.log
yarn-error.log
*.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Miscellaneous
/.angular/cache
/frontend/.angular/cache
/backend/.runtime
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/
**/tempCodeRunnerFile.ts

# System files
.DS_Store
Thumbs.db

# Local data artifacts
/microbes.db
*.env
backend/sql/*.db
backend/sql/*.db.bak
